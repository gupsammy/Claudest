{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "(p=\"${CLAUDE_PLUGIN_ROOT}\"; [[ \"$p\" =~ ^/([a-zA-Z])/(.*)$ ]] && p=\"${BASH_REMATCH[1]^^}:/${BASH_REMATCH[2]}\"; command -v python3 >/dev/null 2>&1 && python3 \"${p}/hooks/memory-setup.py\" || python \"${p}/hooks/memory-setup.py\")"
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "(p=\"${CLAUDE_PLUGIN_ROOT}\"; [[ \"$p\" =~ ^/([a-zA-Z])/(.*)$ ]] && p=\"${BASH_REMATCH[1]^^}:/${BASH_REMATCH[2]}\"; command -v python3 >/dev/null 2>&1 && python3 \"${p}/hooks/memory-context.py\" || python \"${p}/hooks/memory-context.py\")"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "(p=\"${CLAUDE_PLUGIN_ROOT}\"; [[ \"$p\" =~ ^/([a-zA-Z])/(.*)$ ]] && p=\"${BASH_REMATCH[1]^^}:/${BASH_REMATCH[2]}\"; command -v python3 >/dev/null 2>&1 && python3 \"${p}/hooks/memory-sync.py\" || python \"${p}/hooks/memory-sync.py\")"
          }
        ]
      }
    ]
  }
}
